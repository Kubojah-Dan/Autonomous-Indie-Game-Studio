# QuantumForge AI :: environment (copy to .env and fill in your keys)
# ---- required ----
GROQ_API_KEY=your_groq_key_here

# ---- optional (pipeline auto-falls back to Groq if omitted or rate-limited) ----
GEMINI_API_KEY=your_gemini_key_here

# ---- infrastructure ----
MONGO_URL=mongodb://mongo:27017
DB_NAME=quantumforge
CORS_ORIGINS=*
